# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — your key never gets committed.

# Anthropic (Claude) — server-side only, REQUIRED for narratives
ANTHROPIC_API_KEY=

# Jira Cloud REST API — server-side only, OPTIONAL for now
# When unset, the submit endpoint uses the previous Jira snapshot from the store
JIRA_BASE_URL=https://yourdomain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Auth.js — signs the session cookie. Generate with: npx auth secret
AUTH_SECRET=
# Base URL of this app (used for the OAuth callback). Update for production.
AUTH_URL=http://localhost:3000

# Microsoft Entra ID (Azure AD) — company sign-in + SharePoint access.
# This app is registered as a PUBLIC client (PKCE only), so no client secret
# is needed or used — see auth.ts.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# OPTIONAL app-level allowlist (comma-separated work emails). Leave empty if
# you gate access in Entra instead via the enterprise app's "Assignment
# required = Yes" + assigned users (recommended). This is a belt-and-braces
# second check inside the app if you want one.
ALLOWED_EMAILS=

# SharePoint site + submissions list (Microsoft Graph IDs, not URLs).
# Submissions are stored as one row per programme per week in this list.
SHAREPOINT_SITE_ID=
SP_LIST_SUBMISSIONS=

# OPTIONAL dedicated list for the CEO log (decision touches, "viewed" marks,
# notes to leads). Leave EMPTY to store the CEO log inside the submissions list
# above (a single sentinel row that submission reads ignore) — that already
# works on Azure Static Web Apps with no extra setup. Set this only if you'd
# rather keep the submissions list clean; then create a list with a plain
# "Multiple lines of text" column named exactly `Data`. See docs/azure-swa.md.
# NOTE: with neither SharePoint configured, the log falls back to a local JSON
# file (fine for `next dev`, but that state is lost on a read-only host).
SP_LIST_CEOLOG=
